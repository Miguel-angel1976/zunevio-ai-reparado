name: ZUNEVIO AI - Generar APK y AAB

on:
  workflow_dispatch:
  push:
    branches:
      - main
      - principal
    paths:
      - 'ZUNEVIO_AI_REPARADO (2).zip'
      - '.github/workflows/android-build.yml'

permissions:
  contents: read

concurrency:
  group: zunevio-ai-android-build
  cancel-in-progress: false

jobs:
  android-build:
    name: Compilar ZUNEVIO AI
    runs-on: ubuntu-latest
    timeout-minutes: 60

    steps:
      - name: Descargar repositorio
        uses: actions/checkout@v4

      - name: Configurar Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
          cache: gradle

      - name: Configurar Android SDK
        uses: android-actions/setup-android@v3

      - name: Instalar Android SDK 36
        shell: bash
        run: |
          set -euo pipefail
          yes | sdkmanager --licenses >/dev/null || true
          sdkmanager \
            "platform-tools" \
            "platforms;android-36" \
            "build-tools;36.0.0"

      - name: Comprobar y extraer proyecto Android
        shell: bash
        run: |
          set -euo pipefail

          ZIP_FILE="ZUNEVIO_AI_REPARADO (2).zip"

          if [ ! -f "$ZIP_FILE" ]; then
            echo "::error::No existe $ZIP_FILE en la raíz del repositorio."
            echo "Archivos ZIP encontrados:"
            find . -maxdepth 2 -type f -iname '*.zip' -print
            exit 1
          fi

          echo "Verificando integridad del ZIP..."
          unzip -t "$ZIP_FILE"

          mkdir -p "$RUNNER_TEMP/zunevio-android"
          unzip -q "$ZIP_FILE" -d "$RUNNER_TEMP/zunevio-android"

          mapfile -t WRAPPERS < <(
            find "$RUNNER_TEMP/zunevio-android" \
              -type f -name gradlew -print
          )

          if [ "${#WRAPPERS[@]}" -ne 1 ]; then
            echo "::error::Se esperaba exactamente un gradlew."
            printf '%s\n' "${WRAPPERS[@]}"
            exit 1
          fi

          WRAPPER="${WRAPPERS[0]}"
          PROJECT_DIR="$(dirname "$WRAPPER")"

          if [ ! -f "$PROJECT_DIR/settings.gradle" ] && \
             [ ! -f "$PROJECT_DIR/settings.gradle.kts" ]; then
            echo "::error::Falta settings.gradle o settings.gradle.kts."
            exit 1
          fi

          if [ ! -f "$PROJECT_DIR/gradle/wrapper/gradle-wrapper.jar" ]; then
            echo "::error::Falta gradle-wrapper.jar."
            exit 1
          fi

          if [ ! -f "$PROJECT_DIR/gradle/wrapper/gradle-wrapper.properties" ]; then
            echo "::error::Falta gradle-wrapper.properties."
            exit 1
          fi

          if [ ! -f "$PROJECT_DIR/app/google-services.json" ]; then
            echo "::error::Falta app/google-services.json."
            exit 1
          fi

          chmod +x "$WRAPPER"

          echo "PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"
          echo "Proyecto preparado: $PROJECT_DIR"

      - name: Comprobar entorno
        shell: bash
        run: |
          set -euo pipefail
          java -version
          echo "ANDROID_HOME=$ANDROID_HOME"
          echo "Android SDK instalado correctamente."

      - name: Limpiar proyecto
        shell: bash
        run: |
          set -euo pipefail
          cd "$PROJECT_DIR"
          ./gradlew --no-daemon --stacktrace clean

      - name: Ejecutar pruebas unitarias
        shell: bash
        run: |
          set -euo pipefail
          cd "$PROJECT_DIR"
          ./gradlew --no-daemon --stacktrace testDebugUnitTest

      - name: Generar APK Debug
        shell: bash
        run: |
          set -euo pipefail
          cd "$PROJECT_DIR"
          ./gradlew --no-daemon --stacktrace assembleDebug

      - name: Generar APK Release y AAB Release
        shell: bash
        run: |
          set -euo pipefail
          cd "$PROJECT_DIR"
          ./gradlew --no-daemon --stacktrace assembleRelease bundleRelease

      - name: Verificar y recopilar APK y AAB
        shell: bash
        run: |
          set -euo pipefail

          mkdir -p "$GITHUB_WORKSPACE/entrega"

          DEBUG_APK="$PROJECT_DIR/app/build/outputs/apk/debug"
          RELEASE_APK="$PROJECT_DIR/app/build/outputs/apk/release"
          RELEASE_AAB="$PROJECT_DIR/app/build/outputs/bundle/release"

          for DIR in "$DEBUG_APK" "$RELEASE_APK" "$RELEASE_AAB"; do
            if [ ! -d "$DIR" ]; then
              echo "::error::No existe el directorio de salida: $DIR"
              exit 1
            fi
          done

          mapfile -t DEBUG_FILES < <(find "$DEBUG_APK" -maxdepth 1 -type f -name '*.apk' -print)
          mapfile -t RELEASE_FILES < <(find "$RELEASE_APK" -maxdepth 1 -type f -name '*.apk' -print)
          mapfile -t AAB_FILES < <(find "$RELEASE_AAB" -maxdepth 1 -type f -name '*.aab' -print)

          if [ "${#DEBUG_FILES[@]}" -ne 1 ]; then
            echo "::error::Se esperaba un APK Debug. Encontrados: ${#DEBUG_FILES[@]}"
            exit 1
          fi

          if [ "${#RELEASE_FILES[@]}" -ne 1 ]; then
            echo "::error::Se esperaba un APK Release. Encontrados: ${#RELEASE_FILES[@]}"
            exit 1
          fi

          if [ "${#AAB_FILES[@]}" -ne 1 ]; then
            echo "::error::Se esperaba un AAB Release. Encontrados: ${#AAB_FILES[@]}"
            exit 1
          fi

          cp "${DEBUG_FILES[0]}" "$GITHUB_WORKSPACE/entrega/ZUNEVIO_AI_DEBUG.apk"
          cp "${RELEASE_FILES[0]}" "$GITHUB_WORKSPACE/entrega/ZUNEVIO_AI_RELEASE.apk"
          cp "${AAB_FILES[0]}" "$GITHUB_WORKSPACE/entrega/ZUNEVIO_AI_RELEASE.aab"

          for FILE in "$GITHUB_WORKSPACE"/entrega/*.apk "$GITHUB_WORKSPACE"/entrega/*.aab; do
            test -s "$FILE"
            unzip -t "$FILE"
            echo "Correcto: $(basename "$FILE")"
          done

      - name: Comprobar firmas de los APK
        shell: bash
        run: |
          set -euo pipefail

          APKSIGNER="$ANDROID_HOME/build-tools/36.0.0/apksigner"

          "$APKSIGNER" verify --verbose "$GITHUB_WORKSPACE/entrega/ZUNEVIO_AI_DEBUG.apk"
          "$APKSIGNER" verify --verbose "$GITHUB_WORKSPACE/entrega/ZUNEVIO_AI_RELEASE.apk"

      - name: Calcular SHA-256
        shell: bash
        run: |
          set -euo pipefail
          cd "$GITHUB_WORKSPACE/entrega"
          sha256sum *.apk *.aab | tee SHA256SUMS.txt

      - name: Publicar APK y AAB descargables
        uses: actions/upload-artifact@v4
        with:
          name: ZUNEVIO-AI-APK-AAB
          path: entrega/
          if-no-files-found: error
          retention-days: 30
